pkgname=timetrace-gnome-fork
pkgver=0.1.4.gnome51.1
pkgrel=1
pkgdesc='TimeTrace fork with GNOME 51 focus, idle and lock tracking'
arch=('x86_64')
url='https://github.com/post-code-FF/timetrace'
license=('MIT')
depends=('glibc' 'gcc-libs' 'glib2' 'dbus' 'fontconfig' 'freetype2' 'libglvnd' 'libxkbcommon' 'wayland' 'libxcb' 'xcb-util-cursor' 'libx11')
optdepends=('gnome-shell: GNOME bridge extension' 'gnome-shell-extension-appindicator: tray icon in GNOME')
options=('!strip' '!debug')
package() {
    install -Dm755 "$startdir/timetrace-gnome-fork" "$pkgdir/usr/bin/timetrace-gnome-fork"
    install -Dm644 "$startdir/timetrace-gnome-fork.desktop" "$pkgdir/usr/share/applications/timetrace-gnome-fork.desktop"
    install -Dm644 "$startdir/icon.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/timetrace-gnome-fork.png"
    install -Dm644 "$startdir/metadata.json" "$pkgdir/usr/share/gnome-shell/extensions/timetrace-fork@local/metadata.json"
    install -Dm644 "$startdir/extension.js" "$pkgdir/usr/share/gnome-shell/extensions/timetrace-fork@local/extension.js"
    install -Dm644 "$startdir/INSTALL.ru.md" "$pkgdir/usr/share/doc/$pkgname/INSTALL.ru.md"
}
