# Uses the same payload as the Debian installer; no choice of runtime is needed.
pkgname=timetrace-git
pkgver=0.1.7
pkgrel=1
pkgdesc="Time tracker for Linux desktops on X11 and Wayland"
arch=('x86_64')
url="https://github.com/post-code-FF/timetrace"
license=('MIT')
depends=('glibc>=2.31' 'libglvnd' 'libxkbcommon' 'libxcb' 'fontconfig' 'freetype2' 'dbus' 'glib2' 'wayland')
provides=('timetrace')
conflicts=('timetrace')
options=('!strip' '!debug')
source=("timetrace_${pkgver}_amd64.deb::https://github.com/post-code-FF/timetrace/releases/download/v${pkgver}/timetrace_${pkgver}_amd64.deb")
sha256sums=('08faede0667a5d03694a99b4d16427cefc469911d0c4950255a005b0f7807d0f')

package() {
    bsdtar -xf "$srcdir/data.tar.xz" -C "$pkgdir"
}
