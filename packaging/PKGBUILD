# Maintainer: <name> <email>
pkgname=timetrace-git
pkgver=0.1.0
pkgrel=1
pkgdesc="Time tracker for KDE and GNOME"
arch=('x86_64')
url="https://github.com/post-code-FF/timetrace"
license=('MIT')
depends=()
provides=('timetrace')
conflicts=('timetrace')
makedepends=('imagemagick')
source_x86_64=("timetrace-${pkgver}-x86_64.bin::https://github.com/post-code-FF/timetrace/releases/download/v${pkgver}/timetrace")
sha256sums_x86_64=('b6812bed140e84ea06b8c3667169f4aaa890dbf046eb51eb104d32813fc8d2a0')

package() {
    install -Dm755 "${srcdir}/timetrace-${pkgver}-x86_64.bin" "${pkgdir}/usr/bin/timetrace"
    install -Dm644 "${startdir}/timetrace.desktop" "${pkgdir}/usr/share/applications/timetrace.desktop"

    install -d "${pkgdir}/usr/share/icons/hicolor/256x256/apps" "${pkgdir}/usr/share/pixmaps"
    convert "${startdir}/icon.png" -resize 256x256 \
        "${pkgdir}/usr/share/icons/hicolor/256x256/apps/timetrace.png"
    install -Dm644 "${pkgdir}/usr/share/icons/hicolor/256x256/apps/timetrace.png" \
        "${pkgdir}/usr/share/pixmaps/timetrace.png"
}
